rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles. Students can only ever create a 'student' profile for themselves.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'student';
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.roll == resource.data.roll
          && request.resource.data.email == resource.data.email)
        || isAdmin());
      allow delete: if isAdmin();
    }

    // One doc per roll number => roll numbers are unique (create-only, no update).
    match /rollNumbers/{roll} {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /events/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Students may only bump registeredCount by exactly 1 (register / cancel).
      allow update: if isAdmin() || (signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount'])
        && request.resource.data.registeredCount >= 0
        && request.resource.data.registeredCount <= resource.data.capacity
        && math.abs(request.resource.data.registeredCount - resource.data.registeredCount) == 1);
    }

    // Doc id = eventId_uid => a student can register for an event only once.
    match /registrations/{rid} {
      allow get: if signedIn() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow list: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && rid == request.resource.data.eventId + '_' + request.auth.uid;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
  }
}
